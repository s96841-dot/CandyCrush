<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create New Level"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/input_level_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Level number"
            android:inputType="number" />

        <EditText
            android:id="@+id/input_level_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Level name (for multiplayer map)"
            android:inputType="textCapWords" />
        <EditText
            android:id="@+id/input_grid_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grid size (e.g., 8)"
            android:inputType="number" />

        <EditText
            android:id="@+id/input_target_score"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target score"
            android:inputType="number" />

        <EditText
            android:id="@+id/input_moves_limit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Moves limit"
            android:inputType="number" />

        <EditText
            android:id="@+id/input_target_candy_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target candy type (-1 for none)"
            android:inputType="number" />

        <EditText
            android:id="@+id/input_target_candy_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Target candy count"
            android:inputType="number" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom grid layout (optional). One row per line, values separated by commas or spaces."
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/input_custom_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="-1 -1 0 1"
            android:inputType="textMultiLine"
            android:minLines="4" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Describe the level you want (Gemini generates the layout)."
            android:layout_marginTop="12dp" />

        <EditText
            android:id="@+id/input_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Example: I want a level that looks like a flower"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <Button
            android:id="@+id/btn_generate_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Generate layout with Gemini" />

        <TextView
            android:id="@+id/text_ai_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#22000000"
            android:padding="12dp"
            android:text="AI Preview will appear here after generation"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_save_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Preview" />

            <Button
                android:id="@+id/btn_cancel_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>