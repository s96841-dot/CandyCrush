<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gane_image"
    tools:context=".FeedActivity">

    <!-- Spinner for Level Selection & Welcome Text & Logout -->
    <!-- These are assumed to be ABOVE the game grid area in the background image -->
    <Spinner
        android:id="@+id/levelSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:minHeight="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/logoutButtonTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:text="Logout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/TextViewactivity_feed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Welcome!"
        android:textSize="20sp"
        app:layout_constraintTop_toBottomOf="@id/levelSpinner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- === START: Guidelines for the STATIC GRID AREA in your background image === -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_static_grid_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.20" /> <!-- ADJUST THIS PERCENTAGE -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_static_grid_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.85" /> <!-- ADJUST THIS PERCENTAGE -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_static_grid_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.10" /> <!-- ADJUST THIS PERCENTAGE -->

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_static_grid_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.90" /> <!-- ADJUST THIS PERCENTAGE -->
    <!-- === END: Guidelines for STATIC GRID AREA === -->


    <!-- Game Grid View - Constrained to overlay the static grid area -->
    <com.example.travellog.gameui.GameGridView
        android:id="@+id/gameGridView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/guideline_static_grid_top"
        app:layout_constraintBottom_toBottomOf="@id/guideline_static_grid_bottom"
        app:layout_constraintStart_toStartOf="@id/guideline_static_grid_start"
        app:layout_constraintEnd_toEndOf="@id/guideline_static_grid_end" />
    <!-- Note: Removed app:layout_constraintDimensionRatio for now to simplify -->


    <!-- TODO: Add TextViews for "Moves" and "Score" below the grid area,
               constrained appropriately to look like the bottom part of your example image.
               They would likely be constrained to guideline_static_grid_bottom and parentBottom.
    -->

</androidx.constraintlayout.widget.ConstraintLayout>

